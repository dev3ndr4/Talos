# --- LLM CONFIGURATION ---
# The API key for your LLM provider (e.g., Gemini, OpenAI, Anthropic)
LLM_API_KEY=your_api_key_here

# --- DATABASE CONFIGURATION ---
# Internal URL for docker-compose (usually mongodb://db:27017)
MONGODB_URL=mongodb://db:27017
# External URL for local development (usually mongodb://localhost:27017)
# MONGODB_URL=mongodb://localhost:27017

# --- SECURITY ---
# Secret key for JWT generation (change this to a random string)
SECRET_KEY=change-me-to-a-random-string-for-production

# --- FRONTEND CONFIGURATION ---
VITE_API_URL=http://localhost:8000/api
