# --- LLM CONFIGURATION ---
# The API key for your LLM provider (e.g., Gemini, OpenAI, Anthropic)
LLM_API_KEY=your_api_key_here

# --- DATABASE CONFIGURATION ---
# Provide your external MongoDB connection string here
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/talos_db?retryWrites=true&w=majority

# --- SECURITY ---
# Secret key for JWT generation (change this to a random string)
SECRET_KEY=change-me-to-a-random-string-for-production

# --- FRONTEND CONFIGURATION ---
VITE_API_URL=http://localhost:8000/api
